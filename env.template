NEXT_PUBLIC_APP_SPLASH_IMAGE=https://your-domain.com/splash.png
NEXT_PUBLIC_SPLASH_BACKGROUND_COLOR=#0a0f1a
NEXT_PUBLIC_APP_PRIMARY_CATEGORY=finance
NEXT_PUBLIC_APP_HERO_IMAGE=https://your-domain.com/og.png
NEXT_PUBLIC_APP_TAGLINE=Trade with AI Intelligence
NEXT_PUBLIC_APP_OG_TITLE=Pulley – AI Trading Platform
NEXT_PUBLIC_APP_OG_DESCRIPTION=Advanced AI-powered trading platform built on Bitcoin Core Network
NEXT_PUBLIC_APP_OG_IMAGE=https://your-domain.com/og.png

# Your existing variables
NEXT_PUBLIC_PARTICLE_PROJECT_ID=your_particle_project_id
NEXT_PUBLIC_PARTICLE_CLIENT_KEY=your_particle_client_key
