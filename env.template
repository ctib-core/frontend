# Required Variables (Essential for MiniKit to function)
NEXT_PUBLIC_ONCHAINKIT_PROJECT_NAME=Pulley
NEXT_PUBLIC_URL=https://your-domain.com
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_cdp_client_api_key

# Generated by `npx create-onchain --manifest`
FARCASTER_HEADER=base64_header
FARCASTER_PAYLOAD=base64_payload
FARCASTER_SIGNATURE=hex_signature

# Optional Variables (Enhance app appearance and metadata)
NEXT_PUBLIC_APP_ICON=https://your-domain.com/icon.png
NEXT_PUBLIC_APP_SUBTITLE=AI-Powered Trading Platform
